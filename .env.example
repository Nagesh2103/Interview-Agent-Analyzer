# Copy this file to .env and fill in your key, then `export $(cat .env | xargs)`
# or use a tool like python-dotenv / direnv to load it automatically.

# Choose ONE provider: anthropic (default), openai, or groq (groq is free).
# API_PROVIDER=anthropic

# Then set the matching key below (only the one you need):
ANTHROPIC_API_KEY=sk-ant-your-key-here
# OPENAI_API_KEY=sk-your-openai-key-here
# GROQ_API_KEY=gsk-your-groq-key-here

# Optional: override the default model for whichever provider you chose
# INTERVIEW_AGENT_MODEL=claude-sonnet-5
